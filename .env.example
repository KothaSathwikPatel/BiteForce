# Copy to .env for local use. NEVER commit the real .env file.
# On Vercel, set these under Project -> Settings -> Environment Variables.

# --- Database -------------------------------------------------------------
# Local default is a SQLite file. On Vercel use a free Postgres (Neon/Supabase)
# connection string, e.g. postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./bitetrace.db

# --- Privacy --------------------------------------------------------------
# Long random string used to hash device IDs and IPs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_SALT=

# --- Behaviour ------------------------------------------------------------
DEMO_MODE=true          # enables /api/demo/* simulator endpoints
AUTO_SEND=true          # auto-email evidence reports when the AI reviewer approves
ENFORCE_AREA=true       # reject reports whose GPS is far outside the service area
AREA_CENTER_LAT=17.2603 # Shamshabad
AREA_CENTER_LNG=78.3969
AREA_RADIUS_KM=25

# --- Email (Resend) -------------------------------------------------------
# Without your own domain, Resend only delivers to the email you signed up with.
RESEND_API_KEY=
REPORT_FROM_EMAIL=BiteTrace Alerts <onboarding@resend.dev>
# Demo inbox that plays the role of the FSSAI officer. Leave the real FSSAI
# address for production, after domain verification and human sign-off.
REPORT_TO_EMAIL=

# --- AI reviewer (Gemini, free tier) ---------------------------------------
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# --- Claude as the AI reviewer (preferred if set; otherwise Gemini; otherwise rules only) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- Google sign-in (optional). OAuth "Web application" client ID from Google Cloud Console.
# Add http://localhost:8000 and your Vercel URL under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
